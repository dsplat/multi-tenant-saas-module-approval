{
  "name": "dsplat/multi-tenant-saas-module-approval",
  "description": "审批中心",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "dsplat/multi-tenant-saas": "^1.0 || ^2.0 || ^3.0",
    "dsplat/multi-tenant-saas-base": "^3.6",
    "dsplat/multi-tenant-saas-module-matter": "^3.6"
  },
  "autoload": {
    "psr-4": {
      "MultiTenantSaas\\Modules\\Approval\\": ""
    }
  },
  "extra": {
    "saas": {
      "name": "approval",
      "priority": 300,
      "dependencies": [
        "matter"
      ],
      "matter_adapters": [
        "MultiTenantSaas\\Modules\\Approval\\Adapters\\ApprovalMatterAdapter"
      ],
      "conflicts": [],
      "requires_core": ">=3.1.0 <4.0.0",
      "provider": "MultiTenantSaas\\Modules\\Approval\\ApprovalServiceProvider",
      "tenant_toggleable": true,
      "module_loadable": true,
      "default_tenant_enabled": true
    }
  }
}
